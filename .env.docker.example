# Compose substitution values. Use with:
#   docker compose --env-file .env.docker up -d
#
# Without --env-file, Compose reads ./.env, which is also the file the local Next
# dev server uses -- so values there apply to the containers too.

# Leave auth off for a local trial; every request then resolves to one shared
# local admin. Turn it on before exposing this anywhere.
AUTH_ENABLED=false
AUTH_BYPASS_ADMIN=true

# Required once AUTH_ENABLED=true.
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback
ADMIN_DISCORD_IDS=[]

# Browser-facing. The API builds absolute download and logo URLs from this, so it
# must be reachable from the host rather than from inside the compose network.
FASTAPI_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

# Set to true when serving over HTTPS.
SECURE_COOKIES=false
