DATABASE_URL=mysql+pymysql://clip_create:clip_create@127.0.0.1:3306/clip_create
FASTAPI_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_PUBLIC_URL=http://127.0.0.1:3000
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/discord/callback
SESSION_COOKIE_NAME=clip_create_session
OAUTH_STATE_COOKIE_NAME=clip_create_oauth_state
OAUTH_NEXT_COOKIE_NAME=clip_create_oauth_next
STORAGE_ROOT=storage
SECURE_COOKIES=false
AUTH_ENABLED=true
AUTH_BYPASS_ADMIN=true
AUTH_BYPASS_DISPLAY_NAME=Local Test User
ADMIN_DISCORD_IDS=["123456789012345678"]

# Render / brand
RENDER_TRANSITION_STYLE=sweep
RENDER_STING_HOLD_SECONDS=0.6
RENDER_STING_BLEND_SECONDS=0.3
RENDER_BRAND_BLUE=#0B5CD5
RENDER_BRAND_ORANGE=#FF7A18
# Optional: a TTF for labels and stings. Unset uses Pillow's bundled font.
# RENDER_FONT_PATH=
RENDER_FONT_SIZE=42
RENDER_LOGO_MAX_WIDTH=260
MAX_LOGO_SIZE_BYTES=5242880
RENDER_MAX_GRAPH_INPUTS=24
RENDER_FFMPEG_TIMEOUT_SECONDS=1800
